DISCORD_TOKEN=put_your_discord_bot_token_here
SPOTIFY_CLIENT_ID=put_your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=put_your_spotify_client_secret_here
# Optional: set a test Discord server ID for immediate slash-command sync.
# Leave blank to sync commands globally.
GUILD_ID=

# Spotify account linking and Spotify Connect playback (Option A)
# Must match the redirect URI configured in your Spotify Developer Dashboard exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Your Discord numeric user ID; only this account can control your personal Spotify playback.
SPOTIFY_OWNER_DISCORD_ID=put_your_discord_user_id_here
# Optional callback listener settings; defaults work when the browser is on the Ubuntu machine running the bot.
SPOTIFY_CALLBACK_HOST=127.0.0.1
SPOTIFY_CALLBACK_PORT=8888
SPOTIFY_TOKEN_CACHE=.spotify_token_cache
